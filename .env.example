# URL of the Express API (server-side proxy target)
API_URL=http://localhost:4000

# Shown on the Contact page (optional)
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
# Google sign-in client ID (same value as GOOGLE_CLIENT_ID in the API). Put the real one in .env.local, not here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
